# Copy to .env and fill in.  ->  cp .env.example .env

# Shown in the header and browser title
SITE_NAME=Free Stuff

# The one-liner at the top of the public page
SITE_TAGLINE=Take what you'll love.

# The admin password (used on /admin/login). Pick something strong.
ADMIN_PASSWORD=

# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Max image upload size in MB
MAX_UPLOAD_MB=8
