# Copy to .env and fill in.  ->  cp .env.example .env

# Shown in the header and browser title
SITE_NAME=Free Stuff

# The one-liner at the top of the public page
SITE_TAGLINE=Take what you'll love.

# The admin password (used on /admin/login). Pick something strong.
ADMIN_PASSWORD=

# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Max image upload size in MB
MAX_UPLOAD_MB=8

# Timezone used to decide what "today" is when validating pickup dates.
# Leave blank to use the server's local time. e.g. America/Los_Angeles
TIMEZONE=

# Set to 1 when the site is served over HTTPS so the session cookie is
# only ever sent over a secure connection.
SECURE_COOKIES=

# ---------------------------------------------------------------------------
# Admin password (preferred form)
# ---------------------------------------------------------------------------
# Generate with:  python app.py hash-password
# Set this INSTEAD of ADMIN_PASSWORD so the plaintext never sits in a file or
# shows up in `docker inspect`. If both are set, the hash wins.
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Anti-abuse
# ---------------------------------------------------------------------------
# How many reverse proxies sit in front of the app (Traefik, nginx, Cloudflare).
# Get this right: too low and every visitor appears to share the proxy's IP, so
# one spammer rate-limits everybody; too high and a client can forge
# X-Forwarded-For and skip the limiter. 0 = the app is exposed directly.
TRUSTED_PROXIES=0

# Set to 1 to turn away contact addresses on known throwaway-mail domains.
# Off by default — on a board for friends, wrongly rejecting a real person
# costs more than one spam row in the claims table.
BLOCK_DISPOSABLE_EMAIL=

# Refuse to decode images above this pixel count (guards against
# decompression bombs). 50,000,000 is roughly 8000x6000.
MAX_IMAGE_PIXELS=50000000
